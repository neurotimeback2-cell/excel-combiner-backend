# Copy to .env and adjust. All values are optional.
PORT=3000
# 127.0.0.1 = only nginx on this server can reach the API. Use 0.0.0.0 to expose it directly.
HOST=127.0.0.1
# Max size of one uploaded file, in MB.
MAX_FILE_MB=100
# Comma-separated frontend origins allowed to call this API directly. Leave unset when nginx proxies /api.
# CORS_ORIGIN=https://app.example.com
